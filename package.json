{
  "name": "inknest",
  "version": "0.3.1",
  "private": true,
  "description": "A local-first Markdown reader and editor for Windows and macOS.",
  "main": "out/main/index.js",
  "author": "InkNest contributors",
  "license": "UNLICENSED",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.21.0",
    "npm": "11.12.1"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && electron-vite build",
    "version:set": "npm version --no-git-tag-version",
    "smoke:fixtures": "node scripts/release-tools.mjs fixtures",
    "inspect:packages": "node scripts/release-tools.mjs inspect",
    "verify:packaged:mac": "node scripts/release-tools.mjs verify-mac",
    "dist:mac": "npm run build && node scripts/package-macos.mjs",
    "dist:win": "npm run build && node scripts/package-windows.mjs",
    "dist:all": "npm run build && node scripts/package-macos.mjs && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "dompurify": "3.4.15",
    "highlight.js": "11.12.0",
    "katex": "0.18.7",
    "markdown-it": "15.0.2",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.0.0",
    "sharp": "0.35.4",
    "vue": "3.5.42",
    "write-file-atomic": "8.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/write-file-atomic": "4.0.3",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
